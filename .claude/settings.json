{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-sensitive.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/htmlhint-index.js",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node .claude/hooks/selfcheck-index.js",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node .claude/hooks/deno-check.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
